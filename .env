# Development Environment Configuration
# This file contains development-specific settings
# Development mode: Kafka in Docker, ML API local, Next.js local

# Model Configuration
OCC_MODEL_DIR=./artifacts/occ_v2
MODEL_VALIDATION_ENABLED=true
MODEL_RELOAD_ON_ERROR=true

# Kafka Configuration (Kafka runs in Docker, accessible via localhost:19092)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC=dev-occupancy-data
KAFKA_GROUP_ID=dev-occupancy-consumer
ENABLE_KAFKA=true

# API Configuration (ML API runs locally)
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=DEBUG

# Development Settings
DEBUG=true
ENABLE_CORS=true

# Performance (relaxed for development)
MAX_PREDICTION_BATCH_SIZE=50
PREDICTION_TIMEOUT_SECONDS=60

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security (relaxed for development)
ENABLE_RATE_LIMITING=false
