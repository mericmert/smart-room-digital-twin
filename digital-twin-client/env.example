# Next.js Environment Configuration
# Copy this file to .env.local and customize for your environment

# ML API Configuration
ML_API_URL=http://localhost:8000
ML_API_WS_URL=ws://localhost:8000/ws

# Kafka Configuration
KAFKA_BROKER_URL=localhost:19092
KAFKA_TOPIC=docker-occupancy-data
KAFKA_CLIENT_ID=digital-twin-client

# Next.js Configuration
NEXT_PUBLIC_ML_API_URL=http://localhost:8000
NEXT_PUBLIC_ML_API_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_KAFKA_TOPIC=docker-occupancy-data

# Development Settings
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
