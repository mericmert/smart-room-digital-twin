# Environment Variables Configuration for Occupancy ML API
# Copy this file to .env and customize the values for your environment

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Path to model artifacts directory
# Default: ../artifacts/occ_v1 (relative to config.py)
OCC_MODEL_DIR=/path/to/your/model/artifacts

# Enable model validation during startup
# Values: true, false
MODEL_VALIDATION_ENABLED=true

# Enable automatic model reload on errors
# Values: true, false
MODEL_RELOAD_ON_ERROR=false

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================

# Kafka bootstrap servers (comma-separated for multiple brokers)
# Default: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka topic name for sensor data
# Default: test-topic
KAFKA_TOPIC=occupancy-sensor-data

# Kafka consumer group ID
# Default: occupancy-ml-consumer
KAFKA_GROUP_ID=occupancy-ml-consumer

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API server host
# Default: 0.0.0.0
API_HOST=0.0.0.0

# API server port
# Default: 8000
API_PORT=8000

# Logging level
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Maximum batch size for predictions
# Default: 100
MAX_PREDICTION_BATCH_SIZE=100

# Prediction timeout in seconds
# Default: 30
PREDICTION_TIMEOUT_SECONDS=30

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable debug mode (additional logging, error details)
# Values: true, false
# Default: false
DEBUG=false

# Enable CORS for development
# Values: true, false
# Default: false
ENABLE_CORS=false

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Enable metrics collection
# Values: true, false
# Default: false
ENABLE_METRICS=false

# Metrics export port (if enabled)
# Default: 9090
METRICS_PORT=9090

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# API key for authentication (optional)
# Leave empty to disable authentication
API_KEY=

# Enable request rate limiting
# Values: true, false
# Default: false
ENABLE_RATE_LIMITING=false

# Rate limit requests per minute
# Default: 1000
RATE_LIMIT_PER_MINUTE=1000
