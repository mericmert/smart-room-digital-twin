# Docker Environment Configuration
# This file is used when running the API in Docker containers

# Model Configuration
OCC_MODEL_DIR=/app/artifacts/occ_v1
MODEL_VALIDATION_ENABLED=true
MODEL_RELOAD_ON_ERROR=false

# Kafka Configuration (Docker network)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=docker-occupancy-data
KAFKA_GROUP_ID=docker-occupancy-consumer

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Docker Settings
DEBUG=false
ENABLE_CORS=false

# Performance
MAX_PREDICTION_BATCH_SIZE=150
PREDICTION_TIMEOUT_SECONDS=20

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=500
