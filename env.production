# Production Environment Configuration
# This file contains production-specific settings
# Production mode: All services (Kafka, ML API, Next.js) run in Docker

# Model Configuration
OCC_MODEL_DIR=/app/artifacts/occ_v1
MODEL_VALIDATION_ENABLED=true
MODEL_RELOAD_ON_ERROR=false

# Kafka Configuration (all services in Docker network)
KAFKA_BOOTSTRAP_SERVERS=broker:9092
KAFKA_TOPIC=prod-occupancy-sensor-data
KAFKA_GROUP_ID=prod-occupancy-ml-consumer

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Production Settings
DEBUG=false
ENABLE_CORS=true

# Performance (optimized for production)
MAX_PREDICTION_BATCH_SIZE=200
PREDICTION_TIMEOUT_SECONDS=15

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security (strict for production)
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=1000
API_KEY=your-secure-api-key-here
